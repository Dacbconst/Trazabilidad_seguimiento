    insert_reporte_auditoria {
        bigint id PK
        int usuario_id FK "null = sistema"
        varchar usuario_nombre "congelado al momento"
        varchar accion "calendario_crear, registro_eliminar..."
        varchar entidad "calendario, registro, reporte, actividad"
        int entidad_id
        varchar resumen
        text detalle "JSON: campo, antes, despues o valor"
        varchar ip
        datetime created_at "solo se agrega, nunca se edita ni se borra"
    }

    repositorio_usuarios_reporte {
        int id PK
        varchar usuario
        varchar contrasena
        varchar nombre
        varchar correo
        varchar foto "ruta relativa en Azure, Usuarios/USUARIO.jpg, NULL = sin foto"
        enum rol "admin | supervisor | promotor"
        enum categorias "todas, retail, canales; NULL = por su ruta en Xplora"
        int supervisor_canales_id "supervisor de sus registros no retail"
        int supervisor_retail_id "supervisor de sus registros retail"
        enum status "activo | inactivo"
        varchar sesion_token
        datetime ultima_actividad
        datetime avisos_visto_en "hasta cuando vio sus avisos de calendario, NULL = nunca"
        int intentos_fallidos
        datetime bloqueado_hasta
        datetime created_at
        datetime updated_at
    }

    insert_reporte_actividad {
        int id PK
        varchar nombre "boton, ej. Activaciones Verano"
        varchar logica "plantilla que replica"
        varchar badge "Nuevo o vacio"
        tinyint activo "interruptor del admin"
        smallint orden
        int creado_por FK
        datetime created_at
        datetime eliminado_en "borrado logico"
    }

    insert_reporte_registro {
        int id PK
        varchar codigo "RACPABLOCASTELO-001"
        varchar tipo "logica del boton"
        int usuario_id FK
        int supervisor_id FK "supervisor que aprueba, NULL = solo admin"
        varchar estado "Pendiente, Aprobado, Devuelto, Reemplazado"
        varchar motivo_devolucion
        int revisado_por FK
        datetime revisado_en
        varchar pos_id
        varchar punto_venta
        varchar ciudad
        varchar canal
        date fecha
        time hora
        varchar tipo_actividad "escrito por el promotor"
        date fecha_actividad
        time hora_inicio
        time hora_fin
        smallint tiendas_nacional
        smallint tiendas_coberturadas
        smallint visitaron
        smallint interactuaron
        smallint compraron
        mediumtext valores "JSON con el resto, incluye actividad_label"
        datetime created_at
        datetime eliminado_en "borrado logico"
    }

    insert_reporte_registro_modelo {
        int id PK
        int registro_id FK
        varchar modelo
        smallint cantidad
    }

    insert_reporte_registro_foto {
        int id PK
        int registro_id FK
        varchar casilla "stand, interaccion-1..."
        varchar ruta "Azure Blob"
        datetime created_at
    }

    insert_reporte_registro_comentario {
        int id PK
        int registro_id FK
        tinyint orden
        varchar texto
    }

    insert_reporte_login {
        bigint id PK
        int usuario_id FK
        varchar usuario_intentado
        tinyint exito
        varchar motivo
        varchar ip
        varchar user_agent
        datetime created_at
    }

    insert_reporte_mensual {
        int id PK
        varchar tipo "logica"
        char mes "YYYY-MM"
        varchar titulo "nombre de descarga"
        varchar calendario "ruta Azure, solo Activaciones"
        smallint programadas
        text comentarios "uno por linea"
        text registros "ids de registros"
        mediumtext snapshot "copia congelada JSON"
        smallint total_registros
        int creado_por FK
        datetime created_at
        datetime eliminado_en "libera los registros"
    }

    insert_reporte_pop {
        int id PK
        char mes "YYYY-MM"
        enum estado "activo o cerrado"
        int reporte_mensual_id FK
        text comentarios "uno por linea, max 5"
        int creado_por FK
        datetime created_at
        datetime cerrado_en
        datetime eliminado_en "borrado logico"
    }

    insert_reporte_pop_fila {
        int id PK
        int pop_id FK
        varchar material "lo que elige el promotor"
        varchar campana
        int bodega "lo que llego; lo colocado se calcula de los registros"
        datetime created_at
        datetime editado_en
    }

    insert_reporte_pop_catalogo {
        int id PK
        enum tipo "material o campana; dos listas independientes"
        varchar nombre "en mayusculas; unico por tipo"
        int creado_por FK
        datetime created_at
        datetime eliminado_en "borrado logico"
    }

    insert_reporte_pop_asignacion {
        int id PK
        int pop_fila_id FK "material del mes"
        int usuario_id FK "quien recibe"
        int asignado_por FK "quien reparte"
        tinyint nivel "1 supervisor, 2 promotor"
        int cantidad
        datetime created_at
        datetime editado_en
    }

    insert_reporte_calendario {
        int id PK
        varchar nombre "titulo del reporte"
        varchar canal "de repositorio_locales_dtt2"
        tinyint plazo_dias
        text comentarios "uno por linea, max 5"
        datetime comentarios_revisados_en "NULL = cerro y espera revision de comentarios"
        date desde
        date hasta
        enum estado "activo o cerrado"
        datetime activado_en
        datetime vence_en
        datetime cerrado_en
        int reporte_mensual_id FK
        int creado_por FK
        int reactivado_por FK
        datetime reactivado_en
        timestamp created_at
        datetime eliminado_en "borrado logico"
    }

    insert_reporte_calendario_fila {
        int id PK
        int calendario_id FK
        date fecha
        varchar pos_id
        varchar punto_venta
        varchar ciudad
        int promotor_usuario_id "id de Xplora"
        varchar promotor_nombre
        varchar supervisor_nombre
        enum estado "pendiente o cumplido"
        int registro_id FK
        datetime cumplido_en
        datetime editado_en
        int editado_por FK
        timestamp created_at
    }

